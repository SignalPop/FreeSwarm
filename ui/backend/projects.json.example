    {
      "id": "00000000000000000000000000000000",
      "name": "Example",
      "slug": "example",
      "data_dir": "C:\\path\\to\\your\\project\\data",
      "connectors": [],
      "created_at": 0,
      "models": null,
      "sql": {
        "server": "localhost",
        "database": "YourDatabase",
        "tables": [
          "dbo.YourTable"
        ],
        "login": "your_sql_login"
      }
    }
  ],
  "active": null
}
